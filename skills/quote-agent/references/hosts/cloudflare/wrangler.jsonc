// wrangler.jsonc — the Quote Agent Worker (hosts/cloudflare/worker.ts).
// Secrets are NOT here: `wrangler secret put ANTHROPIC_API_KEY`, `A2A_RELAY_TOKEN`
// and `NXIS_WEBHOOK_SIGNING_SECRET`; locally, .dev.vars (see .dev.vars.example).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quote-agent",
  "main": "src/quote-worker.ts",
  "compatibility_date": "2026-10-01",
  // @a2a-js/sdk uses Buffer; example-site.ts signs with node:crypto.
  "compatibility_flags": ["nodejs_compat"],

  // One Durable Object per task: the SDK's task, agent-core's progress, the submit claim.
  "durable_objects": {
    "bindings": [{ "name": "QUOTE_TASKS", "class_name": "QuoteTask" }]
  },
  // SQLite-backed: the synchronous ctx.storage.kv API the claim relies on.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuoteTask"] }],

  "vars": {
    "QUOTE_MODEL": "claude-sonnet-5-5",
    // EXAMPLE: where the site's quote form posts. Fixed here, never taken from a request.
    "QUOTE_SINK_URL": "https://example.com/api/quote"
    // "QUOTE_CARD_WELL_KNOWN": "false"   // when another agent serves /.well-known/agent-card.json
  },

  // Same origin as the site: a route on the site's zone, for the endpoint and both cards.
  // Leave out /.well-known/... if another agent on the site claims it.
  "routes": [
    { "pattern": "example.com/a2a/quote*", "zone_name": "example.com" },
    { "pattern": "example.com/.well-known/agent-card.json", "zone_name": "example.com" }
  ]
  // Or, when this Worker is the site (Workers static assets), drop "routes" and add:
  // "assets": { "directory": "./dist", "binding": "ASSETS",
  //             "run_worker_first": ["/a2a/quote*", "/.well-known/agent-card.json"] }
}
