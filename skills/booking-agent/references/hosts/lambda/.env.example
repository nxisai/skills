# Names only. On AWS these come from template.yaml parameters (plain config)
# and SSM SecureStrings (secrets) — never put a secret value in a Lambda
# environment variable or in this file.

# Plain configuration (Lambda environment, set by template.yaml)
PUBLIC_ORIGIN=
BOOKING_TABLE=
BOOKING_SECRETS_PREFIX=
BOOKING_MODEL=
BOOKING_SINK_URL=
BOOKING_AVAILABILITY_URL=
BOOKING_CARD_WELL_KNOWN=

# Secrets: SSM Parameter Store SecureStrings under BOOKING_SECRETS_PREFIX,
# not environment variables:
#   <prefix>anthropic-api-key
#   <prefix>a2a-relay-token
#   <prefix>webhook-signing-secret
#   <prefix>availability-token      (optional: the availability endpoint's bearer)

# Local checks only (local-check.ts): DynamoDB Local
DYNAMODB_ENDPOINT=
