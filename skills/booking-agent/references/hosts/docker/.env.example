# Copy to .env.local (gitignored) and fill in. Names only here — never values.

# The bearer token the relay sends: the same value as the relay's target
# credential. 32+ characters: openssl rand -hex 32. No default.
A2A_RELAY_TOKEN=

# The site's public origin, as the Agent Card points at it: https://example.com
PUBLIC_ORIGIN=

# Where the site's booking form posts, fixed server-side: https://example.com/api/book
BOOKING_SINK_URL=
# The site's free-slot endpoint, fixed server-side: https://example.com/api/slots
# (example-site.ts, httpAvailability). Required: no calendar, no start.
BOOKING_AVAILABILITY_URL=
# Sent as `Authorization: Bearer …` to it, if it wants one.
BOOKING_AVAILABILITY_TOKEN=
# TEST ONLY: "true", with no availability URL, uses the in-memory example
# calendar (one per replica). Never on a live site.
BOOKING_EXAMPLE_CALENDAR=

# Signs each post to the sink (X-Nxis-Signature), as the sink verifies them.
NXIS_WEBHOOK_SIGNING_SECRET=

# Unset: no model, offered as unavailable, and the form takes bookings.
ANTHROPIC_API_KEY=
# Default: a current Sonnet.
BOOKING_MODEL=

# With the redis profile: redis://redis:6379. Unset: memory, one replica only.
REDIS_URL=
