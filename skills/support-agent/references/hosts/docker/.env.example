# Copy to .env.local (gitignored) and fill in. Names only here — never values.

# The bearer token the relay sends: the same value as the relay's target
# credential. 32+ characters: openssl rand -hex 32. No default.
A2A_RELAY_TOKEN=

# The site's public origin, as the Agent Card points at it: https://example.com
PUBLIC_ORIGIN=

# The site's MCP server, fixed server-side: https://example.com/mcp
SUPPORT_MCP_ENDPOINT=

# The owner's model key. Unset: no model, and the relay lists the agent unavailable.
ANTHROPIC_API_KEY=
# Defaults: claude-sonnet-5-5 composes, claude-haiku-5-5 rewrites.
SUPPORT_MODEL=
SUPPORT_REWRITE_MODEL=

# The gap list (SKILL.md step 3): the site-scoped key, piped in from
# `nxis keys create --scope content_gaps:report …`, never typed or printed,
# and the provisioning MCP server it reports to. Without both, no reports.
SUPPORT_GAP_KEY=
SUPPORT_PROVISIONING_ENDPOINT=

# Question keys and turn references: openssl rand -hex 32. A gap report names its
# question and its turn by a keyed hash made with this; the wording, the prompt and
# the reply go to /data/turns.jsonl, on the volume, and nowhere else.
# Unset: no gap reports are sent (thumbs-up counts still are).
SUPPORT_TURN_REF_SECRET=

# "false" when another agent on the site serves /.well-known/agent-card.json.
SUPPORT_CARD_WELL_KNOWN=
